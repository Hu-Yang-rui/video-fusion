<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══════════════════════════════════════════════════════════
         网络权限（必需）
         ══════════════════════════════════════════════════════════
         Flutter 模板默认只在 debug/ 与 profile/ 的 manifest 里声明
         INTERNET，main/ 里没有。这导致：
           - debug 版能联网（debug manifest 合并了权限）
           - release 版**没有网络权限**，所有 HTTP 请求抛 SocketException
         表现为"网络连接失败，请检查网络连接后重试"，与真实网络无关。

         因此必须在 main/ 显式声明。
         ══════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 网络状态检测：用于区分"无网络"与"服务端错误"，
         在请求失败时给出更准确的原因（而不是笼统的"网络连接失败"）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ══════════════════════════════════════════════════════════
         私信发送图片：为什么不声明相机 / 存储权限
         ══════════════════════════════════════════════════════════
         本应用用 `image_picker` 选图，两条来源都**不需要额外权限**：

         1) 相册：走系统 Photo Picker / ACTION_GET_CONTENT。
            Android 13+ 的 Photo Picker 与各版本的 GET_CONTENT
            都由系统进程代选，调用方**不读取相册**，
            因此不需要任何媒体读取权限。

         2) 拍照：走 ACTION_IMAGE_CAPTURE 交给系统相机应用。
            Android 的规则是——**只有当你声明了相机权限，
            才必须在使用该 intent 前运行时申请它**；
            不声明时可以直接用 intent 拍照。
            也就是说：不声明反而更简单，且拍照照常可用。

         结论：不声明任何存储/相机权限。用户主动选中的那一张图由系统
         交付给我们，我们从不遍历相册，也不持有相机权限。
         这条约束由 `test/android_manifest_test.dart` 守护，
         该测试会扫描本文件的权限字面量，改动前请先看那个测试。
         ══════════════════════════════════════════════════════════ -->

    <application
        android:label="视频融合"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
