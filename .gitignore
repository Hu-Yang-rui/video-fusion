# 探针原始产物（含真实接口响应片段，不入库）
# 注意：只忽略下划线前缀的产物，保留 probe_*.mjs 脚本本身作为可复现证据
# 必须写成 **/_ 而不是 /tool/_：探针也放在 tool/live/ 等子目录里，
# 那些产物含平台下发的签名 URL（auth_key / 有效期内的直链），
# 一旦入库等于泄漏可用的访问凭证。
/tool/**/_*.json
/tool/**/_*.txt
/tool/**/_*.png
/tool/**/_*.xml
/tool/**/_*.jpg
/tool/**/_*.html
/tool/**/_*.bin
/tool/**/_*.mjs
/tool/**/_*.js
/tool/**/_*.dart

# catbus 参考实现的抓取副本（_api.ts / _pp.ts / _sign.ts / _mc.json …），
# 只作移植对照，含真实接口路径与参数，不入公开仓库
/_*.ts
/_*.json
/_*.txt

# ==============================================================
# 本地签名库（抖音 X-Argus / X-Gorgon 签名引擎）
# ==============================================================
# libmetasec_ml.so 及其依赖来自第三方 APK，属再分发受限的二进制：
#  - 体积大（arm64 单文件约 4.5 MB）
#  - 再分发存在法律风险
#  - 与设备侧的 license 绑定，换机器未必可用
#
# 因此绝不入库。需要该能力时自行放入本目录，
# 缺失时整条本地签名链路自动降级（不影响 WebView 路径与其它平台）。
#
# 目录结构：
#   android/app/src/main/jniLibs/arm64-v8a/libmetasec_ml.so
#   android/app/src/main/jniLibs/arm64-v8a/libc++_shared.so   (若依赖)
/android/app/src/main/jniLibs/

# 签名库的 license / 设备指纹转储
/_native/
# ==============================================================
# APK 样本与逆向产物
# ==============================================================
# 官方 APK 本体不入库：
#  - 单个 200-350 MB，体积不可接受
#  - 再分发第三方应用包存在法律风险
#
# 仓库只保留：分析结论（.md）+ 可复现的探针脚本（.mjs / .ps1）
/APK样本/原始安装包/

# 含真实接口响应的探针产物（可能含设备标识与会话片段）
/APK样本/逆向分析/*/探针产物/

# 前端 bundle 快照（24 MB，可从线上重新抓）
/APK样本/逆向分析/*/前端Bundle快照/

# 包结构清单含 so/dex 大小信息，可重新生成，但保留无害
# （不忽略，方便对照）
# 抖音前端 bundle 快照（24 MB，可从线上重抓）
# 归档副本在 APK样本/逆向分析/抖音/前端Bundle快照/（已被上面规则忽略）
/tool/_dy_bundles/
# ==============================================================
# APK 样本与逆向产物：整体不入库
# ==============================================================
# 理由：
#  - 含平台官方 APK 的逆向分析，不适合放在公开仓库
#  - 探针脚本含真实接口路径与参数，会被搜索引擎索引
#  - 完整内容保留在私有仓库 video-fusion-prompts
#
# 本地仍保留在 APK样本/，供本机分析使用。
/APK样本/
# 抖音/B站逆向分析文档（含真实接口路径与风控细节）
# 完整内容在私有仓库 video-fusion-prompts
/douyin-research/
/docs/DOUYIN-*.md
/docs/SESSION-RESULTS.md
/docs/CODE-AUDIT-*.md
# 提示词与封存代码：不入公开仓库
# 完整内容在私有仓库 video-fusion-prompts
/AGENTS.md
/archive/
/tool/VF_DY_LIVE_REPORT.md
/docs/
